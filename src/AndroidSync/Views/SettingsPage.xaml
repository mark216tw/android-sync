<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Com.AndroidSync.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource AppPagePadding}">
        <StackPanel Spacing="16" MaxWidth="760">
            <TextBlock x:Uid="SettingsPageTitle" Style="{StaticResource AppPageTitleStyle}" />

            <Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsAppearanceHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                    <ComboBox
                        x:Uid="SettingsDisplayModeCombo"
                        MinWidth="240"
                        SelectedIndex="{x:Bind ViewModel.SelectedDisplayModeIndex, Mode=TwoWay}"
                        AutomationProperties.Name="顯示模式">
                        <ComboBoxItem x:Uid="DisplayModeSystem" />
                        <ComboBoxItem x:Uid="DisplayModeLight" />
                        <ComboBoxItem x:Uid="DisplayModeDark" />
                    </ComboBox>
                    <ComboBox
                        x:Uid="SettingsColorThemeCombo"
                        MinWidth="240"
                        SelectedIndex="{x:Bind ViewModel.SelectedColorThemeIndex, Mode=TwoWay}"
                        AutomationProperties.Name="主題配色">
                        <ComboBoxItem x:Uid="ColorThemeClassicBlue" />
                        <ComboBoxItem x:Uid="ColorThemeEyeCareYellow" />
                        <ComboBoxItem x:Uid="ColorThemeForestGreen" />
                        <ComboBoxItem x:Uid="ColorThemeTwilightPurple" />
                        <ComboBoxItem x:Uid="ColorThemeNeutralGray" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsToolsHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                    <TextBox
                        x:Uid="SettingsAdbPathBox"
                        Text="{x:Bind ViewModel.AdbPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="SettingsScrcpyPathBox"
                        Text="{x:Bind ViewModel.ScrcpyServerPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="SettingsScrcpyVersionBox"
                        PlaceholderText="5.0.1"
                        Text="{x:Bind ViewModel.ScrcpyServerVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.DetectedToolsSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsStreamHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                    <ComboBox
                        x:Uid="SettingsVideoCodecCombo"
                        MinWidth="240"
                        SelectedIndex="{x:Bind ViewModel.SelectedVideoCodecIndex, Mode=TwoWay}"
                        AutomationProperties.Name="視訊編碼格式">
                        <ComboBoxItem x:Uid="VideoCodecH264" />
                        <ComboBoxItem x:Uid="VideoCodecH265" />
                    </ComboBox>
                    <NumberBox
                        x:Uid="SettingsMaxSizeBox"
                        Minimum="0"
                        Maximum="4096"
                        SmallChange="120"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MaxSize, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="SettingsBitrateBox"
                        Minimum="1"
                        Maximum="64"
                        SmallChange="2"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.BitRateMbps, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="SettingsMaxFpsBox"
                        Minimum="15"
                        Maximum="120"
                        SmallChange="15"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MaxFps, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsStayAwakeToggle"
                        IsOn="{x:Bind ViewModel.StayAwake, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsTurnScreenOffToggle"
                        IsOn="{x:Bind ViewModel.TurnScreenOffOnStart, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsSyncClipboardToggle"
                        IsOn="{x:Bind ViewModel.SyncClipboard, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsEnableAudioToggle"
                        IsOn="{x:Bind ViewModel.EnableAudio, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsCompressedAudioToggle"
                        IsOn="{x:Bind ViewModel.UseCompressedAudio, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsAutoReconnectToggle"
                        IsOn="{x:Bind ViewModel.AutoReconnect, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsShowHudToggle"
                        IsOn="{x:Bind ViewModel.ShowPerformanceHud, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Uid="SettingsSaveButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    AutomationProperties.Name="儲存設定" />
                <TextBlock
                    Text="{x:Bind ViewModel.SaveFeedback, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
