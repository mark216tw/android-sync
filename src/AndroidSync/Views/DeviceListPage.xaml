<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Com.AndroidSync.App.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Com.AndroidSync.App.Models">

    <ScrollViewer Padding="{StaticResource AppPagePadding}">
        <StackPanel Spacing="16" MaxWidth="1120">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DevicePageTitle" Style="{StaticResource AppPageTitleStyle}" Margin="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    <Button
                        x:Uid="RefreshDevicesButton"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="重新掃描裝置" />
                </StackPanel>
            </Grid>

            <InfoBar
                IsOpen="True"
                Visibility="{x:Bind ViewModel.EnvironmentWarning, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.EnvironmentWarning, Mode=OneWay}" />

            <InfoBar
                IsOpen="True"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                Severity="Informational"
                IsClosable="True"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ConnectedDevicesHeader" Style="{StaticResource AppSectionHeaderStyle}" />

                        <StackPanel
                            Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Padding="24"
                            Spacing="8"
                            HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8EA;" FontSize="40" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="EmptyDevicesTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock
                                x:Uid="EmptyDevicesSubtitle"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                TextAlignment="Center" />
                        </StackPanel>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.Devices}"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AndroidDevice">
                                    <Border
                                        Style="{StaticResource AppCardBorderStyle}"
                                        Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind ConnectionType}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button
                                                    x:Uid="SwitchWirelessButton"
                                                    Click="SwitchWirelessButton_Click"
                                                    Tag="{x:Bind}"
                                                    AutomationProperties.Name="切換為無線連線" />
                                                <Button
                                                    x:Uid="StartMirrorButton"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="StartMirrorButton_Click"
                                                    Tag="{x:Bind}"
                                                    IsEnabled="{x:Bind IsReady}"
                                                    AutomationProperties.Name="開始同步畫面" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource AppCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="WirelessConnectHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                            <TextBox
                                x:Uid="WirelessHostBox"
                                PlaceholderText="192.168.1.100"
                                Text="{x:Bind ViewModel.WirelessHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Uid="WirelessPortBox"
                                PlaceholderText="5555"
                                Text="{x:Bind ViewModel.WirelessPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="WirelessConnectButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ConnectWirelessCommand}"
                                AutomationProperties.Name="連線無線裝置" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="WirelessPairHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                            <TextBox
                                x:Uid="PairPortBox"
                                PlaceholderText="37123"
                                Text="{x:Bind ViewModel.PairPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Uid="PairCodeBox"
                                PlaceholderText="123456"
                                Text="{x:Bind ViewModel.PairCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="WirelessPairButton"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.PairWirelessCommand}"
                                AutomationProperties.Name="執行無線配對" />
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource AppCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.HasSavedWirelessDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SavedWirelessHeader" Style="{StaticResource AppSectionHeaderStyle}" />
                            <ListView ItemsSource="{x:Bind ViewModel.SavedWirelessDevices}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SavedWirelessDevice">
                                        <Grid Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Endpoint}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Content="重連"
                                                Click="ReconnectSavedButton_Click"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="重新連線常用無線裝置" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
