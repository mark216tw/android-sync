<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF0067C0</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF004578" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF0067C0" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFF3F6FA" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FFDCE4EE" />
            <SolidColorBrush x:Key="AppVideoContainerBackgroundBrush" Color="#FFEBF0F6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FF60CDFF</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF29A9E8" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0D141C" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7AD6FF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF181C24" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF202632" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF2E3748" />
            <SolidColorBrush x:Key="AppVideoContainerBackgroundBrush" Color="#FF12161D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
