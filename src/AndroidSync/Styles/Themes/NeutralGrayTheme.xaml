<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF525860</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF525860" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF3F444B" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF2E3238" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF3F444B" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF525860" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FFD8DCE2" />
            <SolidColorBrush x:Key="AppVideoContainerBackgroundBrush" Color="#FFE8EAEE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFB0B7C0</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB0B7C0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF9AA2AC" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF828B96" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF151618" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFC6CCD4" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFB0B7C0" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF1C1D1F" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF25272A" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF383B40" />
            <SolidColorBrush x:Key="AppVideoContainerBackgroundBrush" Color="#FF141517" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
